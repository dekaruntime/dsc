// DRAFT — review before committing
//
// Rule: `total` is emitted only where visible analysis of this module proves
// there are no throw sites and no calls into unseen code. Uncaught `throw`,
// known-throwing intrinsics (JSON.parse, decodeURI*), and calls the walker
// cannot see all force the pessimistic default Exception<T, JsError>.
// `total` is a claim the author must own; the draft never emits it silently.
//
// opaque-candidates:
//   A — parameter `a` of add has no visible JS type
//   Add — return of add has no visible JS type
//   B — parameter `b` of add has no visible JS type
//   Handle — parameter `handle` of secret has no visible JS type
//   Scene — object returned by scene
//   Secret — return of secret has no visible JS type
//   Values — parameter `values` of count has no visible JS type
//
// skipped (not a statically verifiable function): scalar

export opaque type A
export opaque type Add
export opaque type B
export opaque type Handle
export opaque type Scene
export opaque type Secret
export opaque type Values

export total fn add(a: A, b: B) Add
export total fn noop() void
export total fn secret(handle: Handle) Secret
export total fn scene() Scene
export total fn count(values: Array<Values>) number
export total fn withDefault(n: number) number
export total fn later() Promise<number>
