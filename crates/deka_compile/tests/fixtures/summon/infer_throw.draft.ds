// DRAFT — review before committing
//
// Rule: `total` is emitted only where visible analysis of this module proves
// there are no throw sites and no calls into unseen code. Uncaught `throw`,
// known-throwing intrinsics (JSON.parse, decodeURI*), and calls the walker
// cannot see all force the pessimistic default Exception<T, JsError>.
// `total` is a claim the author must own; the draft never emits it silently.
//
// opaque-candidates:
//   CallsUnknown — return of callsUnknown has no visible JS type
//   Parses — return of parses has no visible JS type
//   S — parameter `s` of parses has no visible JS type
//   UsesHelper — return of usesHelper has no visible JS type

export opaque type CallsUnknown
export opaque type Parses
export opaque type S
export opaque type UsesHelper

export fn boom() Exception<void, JsError>
export total fn ok() number
export fn parses(s: S) Exception<Parses, JsError>
export fn callsUnknown() Exception<CallsUnknown, JsError>
export fn usesHelper() Exception<UsesHelper, JsError>
export total fn caught() number
