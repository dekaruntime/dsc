  fn open(path: string, write: boolean) Result<number, string>
  fn read(handle: number, max_bytes: number) Result<bytes, string>
  fn write(handle: number, data: bytes) Result<number, string>
  fn close(handle: number) Result<void, string>
}

bridge net {
