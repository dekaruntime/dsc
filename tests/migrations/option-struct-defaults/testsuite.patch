@@ -0,0 +1,14 @@
+interface Opts {
+  path?: string;
+}
+
+fn go(o: Opts) string {
+  return match (o.path) {
+    Some(p) => p,
+    None => "/",
+  }
+}
+
+// An omitted optional property reads as undefined, the erased None.
+const out = go({});
+if (out != "/") { panic("omitted Option field must match None"); }
