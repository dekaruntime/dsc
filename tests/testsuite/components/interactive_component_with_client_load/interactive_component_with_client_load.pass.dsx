import { echo } from "io"
import { signal } from "ui/reactive"

fn Counter() Component {
  const count = signal(0)
  return <button>{count()}</button>
}

const tree = <Counter client:load />
const result = unsafe { deka.ui.renderToString(tree) }
match (result) {
  Ok(rendered) => echo(rendered.html),
  Err(error) => echo(error.message),
  _ => echo("nomatch"),
}
