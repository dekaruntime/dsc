import { echo } from "io"

interface RenderResult {
  html: string;
}

fn Counter() {
  return <button>0</button>
}

const tree = <Counter client:load={true} count={1} />
const result = unsafe<RenderResult> { deka.ui.renderToString(tree) }
match (result) {
  Ok(r) => echo(r.html),
  Err(e) => echo(e.message),
  _ => echo("nomatch"),
}
