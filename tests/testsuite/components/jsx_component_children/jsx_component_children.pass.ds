import { echo } from "io"
import { jsx, jsxs } from "ui/jsx"
import { renderToString } from "ui/server"
interface BoxProps {
  class: string;
  children: Array<Component>;
}
fn Box(props: BoxProps) Component {
  return jsxs("div", {class: props.class, children: props.children})
}
const html = renderToString(jsxs(Box, {class: "card", children: [jsx("p", {children: "hi"})]}))
echo(html.html)
