import { echo } from "io"
import { jsx } from "ui/jsx"
import { renderToString } from "ui/server"
interface CardProps {
  children: string;
}
fn Card(props: CardProps) Component {
  return jsx("div", {children: props.children})
}
const html = renderToString(jsx(Card, {class: "bg-blue-300 w-[50%] p-4", children: "Hello"}))
echo(html.html)
