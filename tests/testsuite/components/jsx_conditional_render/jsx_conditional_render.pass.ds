import { echo } from "io"
import { jsx } from "ui/jsx"
import { renderToString } from "ui/server"
interface BannerProps {
  show: boolean;
}
fn Banner(props: BannerProps) Component {
  return props.show ? jsx("div", {children: "yes"}) : jsx("div", {children: "no"})
}
const html = renderToString(jsx(Banner, {show: true}))
echo(html.html)
