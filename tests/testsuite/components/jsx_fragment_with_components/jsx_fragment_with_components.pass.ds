import { echo } from "io"
import { jsx, jsxs, Fragment } from "ui/jsx"
import { renderToString } from "ui/server"
fn A() Component {
  return jsx("span", {children: "a"})
}
fn B() Component {
  return jsx("span", {children: "b"})
}
const html = renderToString(jsxs(Fragment, {children: [jsx(A, {}), jsx(B, {})]}))
echo(html.html)
