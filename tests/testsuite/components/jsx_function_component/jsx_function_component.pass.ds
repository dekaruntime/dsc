import { echo } from "io"
import { jsx } from "ui/jsx"
import { renderToString } from "ui/server"
interface GreetingProps {
  name: string;
}
fn Greeting(props: GreetingProps) Component {
  return jsx("h1", {children: "Hello " + props.name})
}
const html = renderToString(jsx(Greeting, {name: "Deka"}))
echo(html.html)
