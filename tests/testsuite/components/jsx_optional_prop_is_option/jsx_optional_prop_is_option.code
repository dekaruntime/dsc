interface CardProps {
  title: string;
  subtitle?: string;
}

// Inside the component the prop is `Option<string>`.
fn Card(props: CardProps) Component {
  const sub = match (props.subtitle) {
    Some(s) => s,
    None => "(none)",
  }
  return <article><h2>{props.title}</h2><p>{sub}</p></article>
}

// The caller writes neither `Some` nor `None`: a JSX element is a construction
// site the compiler owns, so it fills the omitted prop and wraps the bare one.
const bare = <Card title={"Hello"} />
const full = <Card title={"Hello"} subtitle={"World"} />
