import { echo } from "io"

fn Badge() {
  return <strong>42</strong>
}

const tree = <Badge server:defer cache="60s"><span slot="fallback">.</span></Badge>
const result = unsafe { deka.ui.renderToString(tree) }
match (result) {
  Ok(r) => echo(r.html),
  Err(e) => echo(e.message),
  _ => echo("nomatch"),
}
