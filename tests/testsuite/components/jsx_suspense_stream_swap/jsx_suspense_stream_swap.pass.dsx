import { echo } from "io"
import { Suspense } from "ui/suspense"

interface RenderResult {
  html: string;
}

async fn Slow() Promise<Component> {
  return <p>ready</p>
}

async fn collect(node: Component) Promise<string> {
  // `renderToStreamHtml` resolves to the stream HTML itself, not the render
  // record, so this is `Promise<string>`. The previous match mixed a Promise
  // arm with string arms and only typechecked because every arm was `<infer>`
  // (deka#469).
  const boxed = unsafe<Promise<string>> { deka.ui.renderToStreamHtml(node) }
  let prom = unwrap(boxed) or {
    return ""
  }
  return await prom
}

async fn Inner() Promise<Component> {
  return <span>inner</span>
}

async fn Nested() Promise<Component> {
  return <Suspense fallback={<em>inner-wait</em>}><Inner /></Suspense>
}

const tree = <Suspense fallback={<p>wait</p>}><Slow /></Suspense>
echo(await collect(tree))

const nested = <Suspense fallback={<p>outer</p>}><Nested /></Suspense>
echo(await collect(nested))
