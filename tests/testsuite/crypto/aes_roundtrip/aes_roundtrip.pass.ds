import { echo } from "io"
import { random_bytes, aes_256_gcm_encrypt, aes_256_gcm_decrypt } from "crypto"
fn utf8(value: string): bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
fn to_hex(value: bytes): string {
  let r = unsafe {
    var s = "";
    var i = 0;
    for (i = 0; i < value.byteLength; i++) {
      var hex = value[i].toString(16);
      s += hex.length < 2 ? "0" + hex : hex;
    }
    return s;
  }
  return match (r) {
    Ok(v) => v,
    Err(e) => ""
  }
}
fn no_aad(): bytes {
  let r = unsafe<bytes> { new Uint8Array(0) }
  return match (r) {
    Ok(v) => v,
    Err(e) => utf8("")
  }
}
let key = match (random_bytes(32)) { Ok(v) => v, Err(e) => utf8("") }
let nonce = match (random_bytes(12)) { Ok(v) => v, Err(e) => utf8("") }
let pt = utf8("hello aead")
let aad = no_aad()
const round = match (aes_256_gcm_encrypt(key, nonce, pt, aad)) {
  Err(e) => "fail-enc",
  Ok(ct) => match (aes_256_gcm_decrypt(key, nonce, ct, aad)) {
    Err(e) => "fail-dec",
    Ok(out) => to_hex(out)
  }
}
echo(round == to_hex(pt))
