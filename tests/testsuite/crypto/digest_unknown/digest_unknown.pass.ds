import { echo } from "io"
import { digest } from "crypto"
fn utf8(value: string) bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8(""),
  }
}
echo(match (digest("md5", utf8("x"))) {
  Ok(v) => "ok",
  Err(e) => "err",
})
