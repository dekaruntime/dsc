import { echo } from "io"
import { hmac, hs256, secure_compare } from "crypto"
fn utf8(value: string): bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
const a = hmac("sha256", utf8("k"), utf8("m"))
const b = hs256(utf8("k"), utf8("m"))
echo(match (a) {
  Err(e) => "fail",
  Ok(x) => match (b) {
    Err(e) => "fail",
    Ok(y) => match (secure_compare(x, y)) {
      Ok(eq) => eq,
      Err(e) => "fail"
    }
  }
})
