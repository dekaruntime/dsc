import { echo } from "io"
import { secure_compare } from "crypto"
fn utf8(value: string) bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8(""),
  }
}
echo(match (secure_compare(utf8("abc"), utf8("abc"))) {
  Ok(v) => v,
  Err(e) => false,
})
