import { echo } from "io"

// first()/last() return Option<T> — and the emitted code really builds
// an Option (deka#561). pop()/shift() are emitted the same way since
// deka#566.
const nums: Array<number> = [3, 4, 5]

let f = unwrap(nums.first()) or { -1 }
echo(string(f))

let l = unwrap(nums.last()) or { -1 }
echo(string(l))

// Empty array takes the absent branch.
const empty: Array<string> = []
let nf = unwrap(empty.first()) or { "none" }
echo(nf)

// first()/last() only read, so they work on frozen const arrays —
// where calling pop() is a compile error instead (deka#566).
const frozen: Array<number> = [7, 8, 9]
let ff = unwrap(frozen.first()) or { -1 }
let fl = unwrap(frozen.last()) or { -1 }
echo(string(ff))
echo(string(fl))

// Literal receiver works too.
let m = unwrap([10, 20, 30].last()) or { -1 }
echo(string(m))

// Match reads the Option without a fallback value.
fn describe(ns: Array<number>) string {
  return match (ns.first()) {
    Some(n) => "starts with " + string(n),
    None => "empty",
  }
}

echo(describe(nums))
echo(describe([]))
