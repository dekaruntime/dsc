import { echo } from "io"

struct User {
  name: string
  nickname: Option<string>
  count: Option<number>
}

const some_empty = User { name: "empty", nickname: Some(""), count: None }
const none_empty = User { name: "none", nickname: None, count: None }
const some_zero = User { name: "zero", nickname: None, count: Some(0) }

const a = some_empty.toJSON().parseJSON<User>()
const b = none_empty.toJSON().parseJSON<User>()
const c = some_zero.toJSON().parseJSON<User>()

echo(match a { Ok(u) => match u.nickname { Some(_) => "Some", None => "None" }, Err(e) => e })
echo(match b { Ok(u) => match u.nickname { Some(_) => "Some", None => "None" }, Err(e) => e })
echo(match c { Ok(u) => match u.count { Some(_) => "Some", None => "None" }, Err(e) => e })
