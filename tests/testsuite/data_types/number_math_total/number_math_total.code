import { echo } from "io"

// Math-backed methods on `number` — the total functions return a plain
// `number` (deka#378 step 2, rfd#40 phase 2).
echo(string((3.7).floor()))
echo(string((3.2).ceil()))
echo(string((3.5).round()))
echo(string((-4.5).abs()))
echo(string((3.9).trunc()))
echo(string((-8).sign()))
echo(string((27).cbrt()))
echo(string((0).exp()))
echo(string((2).max(7)))
echo(string((2).min(7)))
