import { echo } from "io"

// `Object` is no longer ambient (deka#378, RFD 21: ordinary DekaScript does
// not reach host globals). It is still reachable through `unsafe`, which is
// the point of that block -- and the result is a `Result`, so the failure has
// to be handled rather than assumed.
let values = unsafe { Object.values({a: 1, b: 2}).join(",") }
let joined = unwrap(values) or { "none" }
echo(joined)
