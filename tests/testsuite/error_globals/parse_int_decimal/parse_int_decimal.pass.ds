import { echo } from "io"

// `parseInt` is gone (deka#378). `parseNumber(s)` is the replacement and is
// strictly better: it yields `Option<number>` where `parseInt` yielded `NaN`,
// so a string that is not a number is a case rather than a value that poisons
// the arithmetic downstream.
let parsed = unwrap(parseNumber("42")) or {
  0
}
echo(string(parsed))

let bad = unwrap(parseNumber("nope")) or {
  -1
}
echo(string(bad))
