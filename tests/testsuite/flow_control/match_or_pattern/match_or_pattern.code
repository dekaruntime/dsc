import { echo } from "io"

enum Colour {
  Red,
  Green,
  Blue,
}

// One arm, several cases. Without this each alternative needs its own arm with
// a duplicated body, which is what pushes people toward a catch-all `_` that
// swallows cases they meant to enumerate.
fn warmth(c: Colour) string {
  return match (c) {
    Red | Green => "warm",
    Blue => "cool",
  }
}

echo(warmth(Colour.Red))
echo(warmth(Colour.Green))
echo(warmth(Colour.Blue))
