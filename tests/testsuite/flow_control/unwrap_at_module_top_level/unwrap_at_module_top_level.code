import { echo } from "io"

// At module top level, after another binding. The unwrap statement used to be
// classified as a declaration rather than a runtime statement, so it was
// hoisted above this line and read `src` before it was initialised
// (deka#445). Every earlier test had the unwrap inside a function body.
let src: Option<string> = Option.Some("x")
let joined = unwrap(src) or {
  "none"
}
echo(joined)
