import { echo } from "io"
import { write_file, read_file } from "fs"
fn utf8(value: string) bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8(""),
  }
}
fn from_utf8(value: bytes) string {
  let decoded = unsafe { new TextDecoder("utf-8", { fatal: false }).decode(value) }
  return match (decoded) {
    Ok(text) => text,
    Err(err) => "",
  }
}
async fn go() {
  await write_file(".cache/u.txt", utf8("café"))
  const r = await read_file(".cache/u.txt")
  echo(match (r) {
    Ok(buf) => from_utf8(buf),
    Err(e) => "fail",
  })
}
go()
