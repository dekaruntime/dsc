import { echo } from "io"
import { mkdirs, read_dir, write_file } from "fs"
fn utf8(value: string) bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8(""),
  }
}
async fn go() {
  const m = await mkdirs(".cache/d")
  const made = match (m) {
    Ok(v) => true,
    Err(e) => false,
  }
  const w = await write_file(".cache/d/a.txt", utf8("x"))
  const d = await read_dir(".cache/d")
  const names = match (d) {
    Ok(entries) => match (unsafe { entries.map((e) => e.name).join(",") }) {
    Ok(v) => v,
    Err(e) => "",
  },
    Err(e) => "fail",
  }
  const has = match (unsafe<boolean> { String(names).indexOf("a.txt") >= 0 }) {
    Ok(v) => v,
    Err(e) => false,
  }
  echo(string(made && has))
}
go()
