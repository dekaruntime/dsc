import { echo } from "io"
import { mkdirs, read_dir } from "fs"
async fn go() {
  await mkdirs(".cache/parent/child")
  const r = await read_dir(".cache/parent")
  const is_dir = match (r) {
    Err(e) => false,
    Ok(entries) => match (unsafe { entries[0].is_dir === true }) {
    Ok(v) => v,
    Err(e) => false,
  },
  }
  echo(string(is_dir))
}
go()
