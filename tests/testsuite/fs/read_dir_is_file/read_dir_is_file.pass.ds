import { echo } from "io"
import { mkdirs, write_file, read_dir } from "fs"
fn utf8(value: string): bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
async fn go() {
  await mkdirs(".cache/e")
  await write_file(".cache/e/f.txt", utf8("1"))
  const r = await read_dir(".cache/e")
  const is_file = match (r) {
    Err(e) => false,
    Ok(entries) => match (unsafe { entries[0].is_file === true }) {
      Ok(v) => v,
      Err(e) => false
    }
  }
  echo(is_file)
}
go()
