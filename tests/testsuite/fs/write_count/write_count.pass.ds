import { echo } from "io"
import { write_file } from "fs"
fn utf8(value: string): bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
async fn go() {
  const w = await write_file(".cache/n.txt", utf8("abcd"))
  echo(match (w) { Ok(n) => n, Err(e) => 0 })
}
go()
