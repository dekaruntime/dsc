import { echo } from "io"
import { write_file, read_file } from "fs"
fn utf8(value: string): bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
async fn go() {
  const w = await write_file(".cache/empty.txt", utf8(""))
  const r = await read_file(".cache/empty.txt")
  const n = match (r) {
    Ok(buf) => match (unsafe<number> { buf.byteLength }) { Ok(v) => v, Err(e) => -1 },
    Err(e) => -2
  }
  echo(n)
}
go()
