import { echo } from "io"
import { write_file, read_file } from "fs"
fn utf8(value: string): bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
fn from_utf8(value: bytes): string {
  let decoded = unsafe { new TextDecoder("utf-8", { fatal: false }).decode(value) }
  return match (decoded) {
    Ok(text) => text,
    Err(err) => ""
  }
}
async fn go() {
  const w = await write_file(".cache/t.txt", utf8("hi"))
  const wrote = match (w) { Ok(n) => n, Err(e) => 0 }
  const r = await read_file(".cache/t.txt")
  const text = match (r) { Ok(buf) => from_utf8(buf), Err(e) => "fail" }
  echo(wrote > 0 && text == "hi")
}
go()
