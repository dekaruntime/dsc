import { echo } from "io"

// rfd#56 phase 1: generic enum declarations. The case payload type T is
// substituted at each use site — the deka#372 path, exercised from user
// code again after the deka#561 reversal.
enum Box<T> {
  Empty,
  Full(T),
}

fn unwrap(b: Box<number>) number {
  return match (b) {
    Full(value) => value,
    Empty => 0,
  }
}

// The constructor infers Box<number> from the payload.
echo(string(unwrap(Box.Full(5))))
echo(string(unwrap(Box.Empty)))

enum Pair<A, B> {
  Left(A),
  Right(B),
}

fn side(p: Pair<number, string>) string {
  return match (p) {
    Left(a) => string(a),
    Right(b) => b,
  }
}

echo(side(Pair.Right("right")))
echo(side(Pair.Left(2)))
