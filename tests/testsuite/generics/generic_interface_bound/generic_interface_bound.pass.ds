import { echo } from "io"

// rfd#56 phase 2: an interface bound unlocks exactly the members the
// interface declares. `<T: Priced>` keeps the phase-1 list (assign, return,
// store, pass through) plus `price` and `label()`; nothing else.
interface Priced {
  price: number;
  fn label() string;
}

struct Product { name: string; price: number }

fn (p Product) label() string { return p.name }

fn priceTag<T: Priced>(item: T) string {
  return string(item.price) + " " + item.label()
}

// The struct satisfies the interface structurally, so the call is legal and
// the identity form `<T: Priced>(item: T) T` would return a Product.
echo(priceTag(Product { name: "Widget", price: 5 }))
