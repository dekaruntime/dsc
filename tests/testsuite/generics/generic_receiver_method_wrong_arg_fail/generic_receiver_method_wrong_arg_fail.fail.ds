// dsc#101: T binds from the receiver's type argument at the call site, so
// `count.set` has T = number and a string argument is a check-time error
// with a span.
struct Signal<T> { value: T }

fn signal<T>(initial: T) Signal<T> {
  return Signal { value: initial }
}

fn (s mut Signal<T>) set(next: T) void {
  s.value = next
}

let count = signal(0)
count.set("nope")
