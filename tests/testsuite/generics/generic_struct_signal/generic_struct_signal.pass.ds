import { echo } from "io"

// rfd#56 phase 1: user-declared type parameters, unbounded form. `Signal<T>`
// is the motivating case from deka#771: a container that gives back what you
// put in, needing identity rather than capability.
struct Signal<T> { value: T }

fn signal<T>(initial: T) Signal<T> {
  return Signal { value: initial }
}

// The method's <T> binds positionally to the receiver's type argument at
// each call site: `count.set` has T = number, `label.set` has T = string.
fn (s Signal) get<T>() T {
  return s.value
}

fn (s mut Signal) set<T>(next: T) {
  s.value = next
}

// T = number at this call site.
let count = signal(0)
echo(string(count.get()))
count.set(41)
echo(string(count.get()))
count.set(count.get() + 1)
echo(string(count.get()))

// The same struct at a different instantiation in one program: types erase,
// so both shapes are plain __deka_struct values at runtime.
let label = signal("active")
echo(label.get())
