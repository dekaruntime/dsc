// rfd#56 phase 2: an interface bound unlocks exactly the members the
// interface declares. `name` is not one of them, so reading it off
// `<T: Priced>` is a check-time error naming the bound and the field.
interface Priced {
  price: number;
  fn label() string;
}

struct Product { name: string; price: number }

fn (p Product) label() string { return p.name }

fn bad<T: Priced>(item: T) string {
  return item.name
}
