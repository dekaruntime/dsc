// rfd#56 phase 1: once `count` is instantiated at T = number, storing a
// string through the setter is a normal argument-type error at the call
// site — genericity does not weaken the check.
struct Signal<T> { value: T }

fn signal<T>(initial: T) Signal<T> {
  return Signal { value: initial }
}

fn (s mut Signal) set<T>(next: T) {
  s.value = next
}

fn main() {
  let count = signal(0)
  count.set("nope")
}
