import { echo } from "io"
import { format_request } from "http"
fn utf8(value: string): bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
const req = format_request("POST", "/", "h", {}, utf8("abcd"))
echo(match (unsafe<boolean> { req.indexOf("Content-Length: 4") >= 0 }) {
  Ok(v) => v,
  Err(e) => false
})
