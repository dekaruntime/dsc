import { echo } from "io"
import { post } from "http"
fn utf8(value: string): bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
echo(match (post("http://127.0.0.1:1/", "text/plain", utf8("x"))) {
  Ok(v) => "ok",
  Err(e) => "err"
})
