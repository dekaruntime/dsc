import { echo } from "io"

interface Card {
  title: string
  subtitle?: string
}

// `subtitle?: string` is a field of type `Option<string>`. There is no
// presence test -- absence is a case, so it is a branch (deka#416).
fn show(c: Card): string {
  return match (c.subtitle) {
    Some(s) => s,
    None => c.title
  }
}

echo(show({ title: "Hello", subtitle: Some("World") }))
echo(show({ title: "Hello", subtitle: None }))
