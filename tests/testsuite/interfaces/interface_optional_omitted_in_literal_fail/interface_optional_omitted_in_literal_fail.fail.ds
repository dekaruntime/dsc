interface Opts {
  path?: string;
}

fn go(o: Opts) string {
  return match (o.path) {
    Some(p) => p,
    None => "/",
  }
}

// A plain object literal is not a construction site the compiler owns, so an
// omitted optional would be JS `undefined` while the type says `Option<string>`
// -- the runtime hole deka#401 closed for `T?`. Write `path: None`.
const out = go({})
