import { echo } from "io"
import { sign } from "jwt"
fn utf8(value: string): bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
const token = match (sign({ sub: "1234567890", name: "John Doe", iat: 1516239022 }, utf8("secret"), {})) {
  Ok(v) => v,
  Err(e) => "fail"
}
echo(token)
