import { echo } from "io"
import { verify } from "jwt"
fn utf8(value: string): bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
echo(match (verify("eyJhbGciOiJub25lIn0.eyJzdWIiOiIxIn0.", utf8("secret"), {})) {
  Ok(v) => "ok",
  Err(e) => "err"
})
