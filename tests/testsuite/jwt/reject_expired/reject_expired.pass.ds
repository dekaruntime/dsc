import { echo } from "io"
import { sign, verify } from "jwt"
fn utf8(value: string): bytes {
  let encoded = unsafe<bytes> { new TextEncoder().encode(value) }
  return match (encoded) {
    Ok(buf) => buf,
    Err(err) => utf8("")
  }
}
const token = match (sign({ sub: "1", exp: 1 }, utf8("secret"), {})) {
  Ok(v) => v,
  Err(e) => ""
}
echo(match (verify(token, utf8("secret"), {})) {
  Ok(v) => "ok",
  Err(e) => "err"
})
