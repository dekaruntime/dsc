// deka#551: the __deka prelude's globalThis write was removed. The struct
// brand is a string id compared by value, so identity must hold across
// modules with no shared global: declared here-adjacent in types.ds,
// constructed in factory.ds, matched and reflected in this module.
import { echo } from "io"
import { Person } from "./types.ds"
import { make_person } from "./factory.ds"

fn describe(e: Person | number) string {
  return match (e) {
    Person(p) => p.name,
    number(n) => string(n),
  }
}

const p: Person = make_person("Deka")
echo(describe(p))
echo(p.getType().toString())
