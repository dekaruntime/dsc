import { echo } from "io"
const r = unsafe<bytes> { new Uint8Array([65, 66, 67]) }
// dsc#89: `${...}` is checked DekaScript now, and `bytes` has no `.length`
// member in the type system (see the dsc#90 family). The length comes from
// its own annotated unsafe block; the byte view still flows through `r`.
const len = match (unsafe<number> { new Uint8Array([65, 66, 67]).length }) {
  Ok(v) => v,
  Err(e) => 0,
}
echo(match (r) {
  Ok(v) => `${len}:${v[0]}:${v[2]}`,
  Err(e) => `err: ${e.message}`,
})
