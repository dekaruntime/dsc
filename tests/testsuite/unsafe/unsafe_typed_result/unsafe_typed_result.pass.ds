import { echo } from "io"

// deka#460: `unsafe<T>` declares what the block hands back. The error side is
// always `JsError` -- whatever JavaScript threw -- so it is not annotated.
const upper = unsafe<string> { String(42) }

match (upper) {
  Ok(v) => echo(v),
  Err(e) => echo("threw"),
}

// `void` is the honest annotation for a block that returns nothing.
const nothing = unsafe<void> { globalThis.__deka_probe = 1 }
match (nothing) {
  Ok(v) => echo("ok"),
  Err(e) => echo("threw"),
}
