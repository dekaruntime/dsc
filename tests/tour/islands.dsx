import { echo } from "io"

struct CounterProps {
  start: number
}

fn Counter(props: CounterProps) Component {
  return <button>{props.start}</button>
}

const element = <Counter client="load" start={5} />
const result = unsafe { deka.ui.renderToString(element) }
match (result) {
  Ok(r) => echo(r.html),
  Err(e) => echo(e.message),
}
