import { echo } from "io"

// One idea, two spellings. Both give the field the type `Option<T>`.

// `email: string?` — spelled on the type.
struct User {
  name: string
  email: string?
}

// `nickname?: string` — spelled on the field name. Same meaning.
interface Profile {
  nickname?: string
}

const user = User { name: "DekaScript", email: None }

// Some and None are the only cases, so no catch-all arm is needed —
// the compiler checks that you covered both.
const contact = match (user.email) {
  Some(value) => value,
  None => "no email"
}

// There is no presence test. Absence is a case, so it is a branch.
fn greet(profile: Profile): string {
  return match (profile.nickname) {
    Some(name) => name,
    None => "friend"
  }
}

echo(contact)
echo(greet({ nickname: None }))
echo(greet({ nickname: Some("Deka") }))

// A plain object literal must say which one it means — `greet({})` does not
// compile. A JSX element is different: the compiler owns that construction
// site, so `<Card title="Hello" />` fills the omitted prop with None and wraps
// a bare `subtitle="World"` in Some. See the props lesson.
