import { echo } from "io"

enum Status {
  Queued
  Running
  Done
  Failed
}

// An arm can list several alternatives with `|`. Without it each case needs
// its own arm with a duplicated body, which is what tempts people into a
// catch-all `_` that swallows cases they meant to enumerate.
fn label(s: Status): string {
  return match (s) {
    Queued | Running => "in flight",
    Done => "finished",
    Failed => "gave up"
  }
}

// Alternatives count toward exhaustiveness and no further: `Queued | Running`
// covers exactly those two, so dropping the `Failed` arm is an error rather
// than a silently accepted gap.

// An alternative may not bind a name. Every alternative would have to bind the
// same names for the body to be well typed, and the value would have to come
// from whichever one matched:
//
//   Failed(message) | Queued => message
//                      ^ does not bind `message`

echo(label(Status.Queued))
echo(label(Status.Done))
echo(label(Status.Failed))
