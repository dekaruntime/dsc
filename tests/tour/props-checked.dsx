interface CardProps {
  title: string
  subtitle?: string
}

interface LayoutProps {
  children: Component
}

// Props are checked at the call site, not only where they are read. A missing
// required prop, a wrong type, or a name that is not a prop at all are all
// compile errors on the `<Card … />` line.
fn Card(props: CardProps) Component {
  const sub = match (props.subtitle) {
    Some(s) => <p>{s}</p>,
    None => <></>
  }
  return <article>
    <h2>{props.title}</h2>
    {sub}
  </article>
}

// `children` is filled by nesting rather than by an attribute.
fn Layout(props: LayoutProps) Component {
  return <main>{props.children}</main>
}

const bare = <Card title="Hello" />                      // `subtitle?` may be omitted
const full = <Card title="Hello" subtitle="DekaScript" />
const page = <Layout><Card title="Hello" /></Layout>     // fills `children`

// Each of these is a compile error:
//
//   <Card />                          missing required prop `title`
//   <Card title={42} />               prop `title` expects type `string`
//   <Card title="x" subtitel="y" />   interface `CardProps` has no prop `subtitel`
//   <Layout></Layout>                 missing required prop `children`
