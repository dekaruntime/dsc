interface CardProps {
  title: string
  subtitle?: string
}

fn Card(props: CardProps) Component {
  // `subtitle?: string` is `Option<string>` here, so absence is a branch.
  // Rendering it directly would put the Option itself into the DOM.
  const sub = match (props.subtitle) {
    Some(s) => <p>{s}</p>,
    None => <></>
  }

  return <div>
    <h2>{props.title}</h2>
    {sub}
  </div>
}

// The caller writes neither Some nor None: a JSX element is a construction
// site the compiler owns, so it wraps this bare value in Some, and fills an
// omitted `subtitle` with None.
<Card title="Hello" subtitle="DekaScript" />
