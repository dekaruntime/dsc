import { echo } from "io"
struct CounterState {
  count: number
}

fn increment(s: CounterState) CounterState {
  return CounterState { count: s.count + 1 }
}

fn add(s: CounterState, n: number) CounterState {
  return CounterState { count: s.count + n }
}

let state = CounterState { count: 0 }
echo(string(state.count))
state = increment(state)
echo(string(state.count))
state = add(state, 5)
echo(string(state.count))
