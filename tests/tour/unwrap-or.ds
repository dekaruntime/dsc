import { echo } from "io"

// `unwrap` names the happy path. Everything after `or` is the absent case, and
// the block is required — `let v = unwrap(o)` on its own does not compile.
// There is no spelling that skips it, which is what makes this unlike Rust's
// `.unwrap()`, where the lazy form is also the shortest.

// The block can supply the value.
fn label(o: Option<string>): string {
  let v = unwrap(o) or { "fallback" }
  return v
}

// Or it can leave the function. `return` here returns from `early`, not from
// the block — which is why `unwrap … or` is a binding form rather than an
// expression. An expression would have to become an IIFE, and a `return`
// inside an IIFE returns from the IIFE.
fn early(o: Option<string>): string {
  let v = unwrap(o) or { return "exited" }
  return "got " + v
}

// `Result` works the same way, unwrapping its `Ok` payload.
fn attempt(): Result<string, string> {
  return Ok("y")
}

fn tried(): string {
  let v = unwrap(attempt()) or { "no" }
  return v
}

// `or match` enumerates the failure modes instead of collapsing them. The arms
// match the original value, so `unwrap` supplies the `Ok` arm and you write the
// rest -- and because they are real match arms, a missing case is an error.
fn described(r: Result<string, string>): string {
  let v = unwrap(r) or match {
    Err(message) => "failed: " + message
  }
  return v
}

echo(label(Some("a")))
echo(label(None))
echo(early(None))
echo(tried())
echo(described(Err("boom")))
